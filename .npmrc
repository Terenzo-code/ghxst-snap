# This app depends on a couple of packages whose published peer-dependency
# ranges haven't caught up to React 19 yet. legacy-peer-deps=true makes npm
# install anyway, the same way `npm install --legacy-peer-deps` does locally
# — set here so it applies automatically on any machine or CI/deploy
# environment (Vercel, Netlify, etc.) without anyone needing to remember
# the flag.
legacy-peer-deps=true
