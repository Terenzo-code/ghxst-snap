# Copy this file to .env and fill in VITE_APPWRITE_PROJECT_ID.
# Everything else below already matches the fixed IDs baked into
# appwrite.json — once you run `appwrite deploy` (see SETUP.md),
# these values will just work as-is, no copying generated IDs required.

VITE_APPWRITE_PROJECT_ID=''
VITE_APPWRITE_URL='https://cloud.appwrite.io/v1'
VITE_APPWRITE_DATABASE_ID='ghxst-db'
VITE_APPWRITE_STORAGE_ID='media'
VITE_APPWRITE_USER_COLLECTION_ID='users'
VITE_APPWRITE_POST_COLLECTION_ID='posts'
VITE_APPWRITE_SAVES_COLLECTION_ID='saves'
VITE_APPWRITE_FOLLOWS_COLLECTION_ID='follows'
VITE_APPWRITE_LIKES_COLLECTION_ID='likes'
